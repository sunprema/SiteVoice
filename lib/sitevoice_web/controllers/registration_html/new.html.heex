<div class="auth-page">
  <div class="auth-page-glow"></div>

  <%!-- Logo --%>
  <a href="/" class="auth-logo-standalone">
    Site<span>Voice</span>&nbsp;AI
  </a>

  <%!-- Card --%>
  <div class="auth-card">

    <%!-- Heading --%>
    <div class="auth-form-heading">CREATE ACCOUNT</div>
    <p class="auth-tagline">Set up your organization and start reporting in minutes.</p>

    <%!-- Error banner --%>
    <%= if @errors != [] do %>
      <div class="auth-alert-error" style="margin-bottom: 20px;">
        <ul class="auth-error-list">
          <%= for error <- @errors do %>
            <li class="auth-error-item"><%= error %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <form method="post" action={~p"/register"} class="auth-form">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

      <div class="auth-field">
        <label class="auth-label" for="registration_org_name">Company / Organization</label>
        <input
          id="registration_org_name"
          type="text"
          name="registration[org_name]"
          value={Map.get(@params, "org_name", "")}
          placeholder="Acme Construction"
          class="auth-input"
          required
          autocomplete="organization"
        />
      </div>

      <div class="auth-field">
        <label class="auth-label" for="registration_name">Your Full Name</label>
        <input
          id="registration_name"
          type="text"
          name="registration[name]"
          value={Map.get(@params, "name", "")}
          placeholder="Jane Smith"
          class="auth-input"
          required
          autocomplete="name"
        />
      </div>

      <div class="auth-field">
        <label class="auth-label" for="registration_email">Work Email</label>
        <input
          id="registration_email"
          type="email"
          name="registration[email]"
          value={Map.get(@params, "email", "")}
          placeholder="jane@acme.com"
          class="auth-input"
          required
          autocomplete="email"
        />
      </div>

      <div class="auth-field">
        <label class="auth-label" for="registration_password">Password</label>
        <input
          id="registration_password"
          type="password"
          name="registration[password]"
          placeholder="At least 8 characters"
          class="auth-input"
          required
          minlength="8"
          autocomplete="new-password"
        />
      </div>

      <div class="auth-field">
        <label class="auth-label" for="registration_password_confirmation">Confirm Password</label>
        <input
          id="registration_password_confirmation"
          type="password"
          name="registration[password_confirmation]"
          placeholder="Repeat your password"
          class="auth-input"
          required
          autocomplete="new-password"
        />
      </div>

      <button type="submit" class="auth-submit">Create Account</button>
    </form>

    <div class="auth-divider" style="margin-top: 28px;">
      <div class="auth-divider-line"></div>
      <div class="auth-divider-text-wrap">
        <span class="auth-divider-text">or</span>
      </div>
      <div class="auth-divider-line"></div>
    </div>

    <p style="text-align: center; margin-top: 16px;">
      <a href={~p"/sign-in"} class="auth-toggler" style="opacity: 0.7; font-size: 13px;">
        Already have an account? <strong style="color: var(--orange); font-weight: 600;">Sign In →</strong>
      </a>
    </p>
  </div>

  <%!-- Footer --%>
  <div class="sign-out-footer">SITEVOICE AI · BUILT FOR THE FIELD</div>
</div>
